# Groq Cloud API key. Set this only on Vercel, marked Sensitive.
# Never commit a real key, and do not place it on EC2, in GitHub Actions, or in the frontend.
GROQ_API_KEY=

# Model id sent to Groq. It must support tool calling.
# llama-3.3-70b-versatile is a common choice. Confirm the id in the Groq console.
GROQ_MODEL=llama-3.3-70b-versatile

# Shared HMAC secret. Must match ASSISTANT_SHARED_SECRET on EC2.
# Generate with: openssl rand -hex 32
ASSISTANT_SHARED_SECRET=

# EC2 API base URL, including the trailing slash.
# The service calls {APP_API_BASE_URL}assistant/tools/{name}.
APP_API_BASE_URL=http://localhost:3200/api/
